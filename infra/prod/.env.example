# Copy to .env (same directory) and fill in. Generate secrets with:
#   openssl rand -base64 32
DOMAIN=cinecastiga.ro

POSTGRES_PASSWORD=
SEAP_WEB_PASSWORD=
MEILI_MASTER_KEY=
BETTER_AUTH_SECRET=
# Optional. Tokens of ONRC persons in links; empty = derived from BETTER_AUTH_SECRET.
# If BETTER_AUTH_SECRET or this one changes, put the old value in PERSON_KEY_SECRET_PREVIOUS (comma-separated)
# or the person links made before stop opening.
PERSON_KEY_SECRET=
PERSON_KEY_SECRET_PREVIOUS=

# Outbound mail for login codes (2FA). Required: since 5 Nov 2026 a production
# server without SMTP_HOST refuses to send a code and never logs it, so nobody
# can sign in (apps/web/lib/mail.ts). Only next dev or a loopback preview prints codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# ASCII display name only: a "?" or diacritics get MIME-encoded and Resend's SMTP
# front then rejects the sender with "550 domain is not verified".
SMTP_FROM=cinecastiga <noreply@cinecastiga.ro>

DATA_AS_OF=2026-07-31
DATA_MODE=snapshot

# Authenticated, on-demand document acquisition. Global maximum: one file/minute.
# false disables new acquisition and parks the worker without source requests.
DOCUMENTS_ENABLED=true
